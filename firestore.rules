rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUser() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'photoUrl',
        'beforePhotoUrl',
        'afterPhotoUrl',
        'weight',
        'height',
        'bmi',
        'bmiCategory',
        'goal',
        'targetWeight',
        'gender',
        'birthDate',
        'fitnessLevel',
        'onboardingCompleted',
        'onboardingCompletedAt',
        'createdAt'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.displayName is string
      && request.resource.data.displayName.size() <= 50
      && request.resource.data.email is string
      && request.resource.data.email.size() <= 120
      && (!request.resource.data.keys().hasAny(['photoUrl'])
        || request.resource.data.photoUrl == null
        || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 500))
      && (!request.resource.data.keys().hasAny(['beforePhotoUrl'])
        || request.resource.data.beforePhotoUrl == null
        || (request.resource.data.beforePhotoUrl is string && request.resource.data.beforePhotoUrl.size() <= 500))
      && (!request.resource.data.keys().hasAny(['afterPhotoUrl'])
        || request.resource.data.afterPhotoUrl == null
        || (request.resource.data.afterPhotoUrl is string && request.resource.data.afterPhotoUrl.size() <= 500))
      && (!request.resource.data.keys().hasAny(['weight'])
        || (request.resource.data.weight is number
          && request.resource.data.weight >= 20
          && request.resource.data.weight <= 350))
      && (!request.resource.data.keys().hasAny(['height'])
        || (request.resource.data.height is number
          && request.resource.data.height >= 80
          && request.resource.data.height <= 250))
      && (!request.resource.data.keys().hasAny(['bmi'])
        || (request.resource.data.bmi is number
          && request.resource.data.bmi > 0
          && request.resource.data.bmi <= 100))
      && (!request.resource.data.keys().hasAny(['bmiCategory'])
        || request.resource.data.bmiCategory == null
        || (request.resource.data.bmiCategory is string && request.resource.data.bmiCategory.size() <= 40))
      && (!request.resource.data.keys().hasAny(['goal'])
        || request.resource.data.goal == null
        || (request.resource.data.goal is string && request.resource.data.goal.size() <= 120))
      && (!request.resource.data.keys().hasAny(['targetWeight'])
        || (request.resource.data.targetWeight is number
          && request.resource.data.targetWeight >= 20
          && request.resource.data.targetWeight <= 350))
      && (!request.resource.data.keys().hasAny(['gender'])
        || request.resource.data.gender == null
        || (request.resource.data.gender is string && request.resource.data.gender.size() <= 40))
      && (!request.resource.data.keys().hasAny(['birthDate'])
        || request.resource.data.birthDate == null
        || (request.resource.data.birthDate is string && request.resource.data.birthDate.size() <= 40))
      && (!request.resource.data.keys().hasAny(['fitnessLevel'])
        || request.resource.data.fitnessLevel == null
        || (request.resource.data.fitnessLevel is string && request.resource.data.fitnessLevel.size() <= 60))
      && (!request.resource.data.keys().hasAny(['onboardingCompleted'])
        || request.resource.data.onboardingCompleted is bool)
      && (!request.resource.data.keys().hasAny(['onboardingCompletedAt'])
        || request.resource.data.onboardingCompletedAt is number)
      && (!request.resource.data.keys().hasAny(['createdAt'])
        || request.resource.data.createdAt is number);
    }

    function validWorkout() {
      return request.resource.data.keys().hasOnly([
        'id',
        'title',
        'subtitle',
        'intensity',
        'durationMinutes',
        'exercises',
        'exerciseCount',
        'isCompleted',
        'isCustom',
        'dayOfWeek',
        'dayType'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 120
      && request.resource.data.durationMinutes is int
      && request.resource.data.durationMinutes >= 0
      && request.resource.data.dayOfWeek is int
      && request.resource.data.dayOfWeek >= 1
      && request.resource.data.dayOfWeek <= 7
      && (!request.resource.data.keys().hasAny(['exerciseCount'])
        || (request.resource.data.exerciseCount is int
          && request.resource.data.exerciseCount >= 0
          && request.resource.data.exerciseCount <= 50))
      && (!request.resource.data.keys().hasAny(['dayType'])
        || request.resource.data.dayType in ['TRAINING', 'RECOVERY', 'REST'])
      && (!request.resource.data.keys().hasAny(['isCustom'])
        || request.resource.data.isCustom is bool)
      && request.resource.data.isCompleted is bool;
    }

    function validExercise() {
      return request.resource.data.keys().hasOnly([
        'id',
        'name',
        'sets',
        'reps',
        'weight',
        'isCompleted',
        'notes',
        'poseTypeKey',
        'primaryMuscle',
        'catalogItemId',
        'durationSeconds',
        'orderIndex'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() <= 120
      && request.resource.data.sets is int
      && request.resource.data.sets >= 0
      && request.resource.data.reps is int
      && request.resource.data.reps >= 0
      && (!request.resource.data.keys().hasAny(['poseTypeKey'])
        || request.resource.data.poseTypeKey is string)
      && (!request.resource.data.keys().hasAny(['primaryMuscle'])
        || request.resource.data.primaryMuscle is string)
      && (!request.resource.data.keys().hasAny(['catalogItemId'])
        || request.resource.data.catalogItemId == null
        || request.resource.data.catalogItemId is string)
      && (!request.resource.data.keys().hasAny(['durationSeconds'])
        || (request.resource.data.durationSeconds is int && request.resource.data.durationSeconds >= 0))
      && (!request.resource.data.keys().hasAny(['orderIndex'])
        || (request.resource.data.orderIndex is int && request.resource.data.orderIndex >= 0))
      && request.resource.data.isCompleted is bool;
    }

    function validProgress() {
      return request.resource.data.keys().hasOnly([
        'weight',
        'bodyFat',
        'leanMass',
        'date',
        'note',
        'userId'
      ])
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.weight is number
      && request.resource.data.weight >= 20
      && request.resource.data.weight <= 350
      && (!request.resource.data.keys().hasAny(['bodyFat'])
        || (request.resource.data.bodyFat is number
          && request.resource.data.bodyFat >= 0
          && request.resource.data.bodyFat <= 80))
      && (!request.resource.data.keys().hasAny(['leanMass'])
        || (request.resource.data.leanMass is number
          && request.resource.data.leanMass >= 0
          && request.resource.data.leanMass <= 250
          && request.resource.data.leanMass <= request.resource.data.weight))
      && (!request.resource.data.keys().hasAny(['note'])
        || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
      && request.resource.data.date is number
      && request.resource.data.date <= request.time.toMillis() + 5 * 60 * 1000;
    }

    function validWorkoutSession() {
      return request.resource.data.keys().hasOnly([
        'workoutId',
        'completedAt',
        'durationMinutes',
        'intensity',
        'source'
      ])
      && request.resource.data.workoutId is string
      && request.resource.data.workoutId.size() > 0
      && request.resource.data.workoutId.size() <= 120
      && request.resource.data.completedAt is number
      && request.resource.data.completedAt > 0
      && request.resource.data.durationMinutes is int
      && request.resource.data.durationMinutes >= 0
      && request.resource.data.durationMinutes <= 600
      && (!request.resource.data.keys().hasAny(['intensity'])
        || request.resource.data.intensity == null
        || (request.resource.data.intensity is string
          && request.resource.data.intensity.size() <= 40))
      && request.resource.data.source in ['MANUAL', 'POSE'];
    }

    function validCustomWorkout() {
      return request.resource.data.keys().hasOnly([
        'id',
        'title',
        'goal',
        'durationMinutes',
        'exercises',
        'createdAt',
        'injuryAware'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 120
      && request.resource.data.durationMinutes is int
      && request.resource.data.durationMinutes >= 0
      && request.resource.data.durationMinutes <= 240
      && request.resource.data.exercises is list
      && request.resource.data.exercises.size() > 0
      && request.resource.data.exercises.size() <= 50
      && request.resource.data.createdAt is number
      && request.resource.data.injuryAware is bool;
    }

    function validFoodLog() {
      return request.resource.data.keys().hasOnly([
        'id',
        'name',
        'mealType',
        'servingText',
        'category',
        'source',
        'planImportKey',
        'aiConfidence',
        'notes',
        'calories',
        'proteinGrams',
        'carbsGrams',
        'fatGrams',
        'eatenAt',
        'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.mealType is string
      && request.resource.data.mealType.size() > 0
      && request.resource.data.mealType.size() <= 40
      && (!request.resource.data.keys().hasAny(['servingText'])
        || request.resource.data.servingText == null
        || (request.resource.data.servingText is string && request.resource.data.servingText.size() <= 80))
      && (!request.resource.data.keys().hasAny(['category'])
        || request.resource.data.category == null
        || (request.resource.data.category in ['protein', 'carb', 'veg', 'snack', 'mixed']))
      && (!request.resource.data.keys().hasAny(['source'])
        || request.resource.data.source in ['MANUAL', 'AI', 'PLAN'])
      && (!request.resource.data.keys().hasAny(['planImportKey'])
        || request.resource.data.planImportKey == null
        || (request.resource.data.planImportKey is string && request.resource.data.planImportKey.size() <= 120))
      && (!request.resource.data.keys().hasAny(['aiConfidence'])
        || request.resource.data.aiConfidence == null
        || (request.resource.data.aiConfidence is number
          && request.resource.data.aiConfidence >= 0
          && request.resource.data.aiConfidence <= 1))
      && (!request.resource.data.keys().hasAny(['notes'])
        || request.resource.data.notes == null
        || (request.resource.data.notes is string && request.resource.data.notes.size() <= 300))
      && request.resource.data.calories is int
      && request.resource.data.calories >= 0
      && request.resource.data.calories <= 5000
      && request.resource.data.proteinGrams is int
      && request.resource.data.proteinGrams >= 0
      && request.resource.data.proteinGrams <= 1000
      && request.resource.data.carbsGrams is int
      && request.resource.data.carbsGrams >= 0
      && request.resource.data.carbsGrams <= 1000
      && request.resource.data.fatGrams is int
      && request.resource.data.fatGrams >= 0
      && request.resource.data.fatGrams <= 1000
      && request.resource.data.eatenAt is number
      && (!request.resource.data.keys().hasAny(['updatedAt'])
        || request.resource.data.updatedAt is number);
    }

    function validMealPlan() {
      return request.resource.data.keys().hasOnly([
        'id',
        'title',
        'createdAt',
        'days'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 120
      && request.resource.data.createdAt is number
      && request.resource.data.days is list
      && request.resource.data.days.size() == 7;
    }

    function validReminder() {
      return request.resource.data.keys().hasOnly([
        'id',
        'title',
        'hour',
        'minute',
        'enabled',
        'daysOfWeek'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 80
      && request.resource.data.hour is int
      && request.resource.data.hour >= 0
      && request.resource.data.hour <= 23
      && request.resource.data.minute is int
      && request.resource.data.minute >= 0
      && request.resource.data.minute <= 59
      && request.resource.data.enabled is bool
      && request.resource.data.daysOfWeek is list
      && request.resource.data.daysOfWeek.size() > 0
      && request.resource.data.daysOfWeek.size() <= 7;
    }

    function validInjuryProfile() {
      return request.resource.data.keys().hasOnly([
        'kneeSensitive',
        'shoulderSensitive',
        'lowerBackSensitive',
        'notes'
      ])
      && request.resource.data.kneeSensitive is bool
      && request.resource.data.shoulderSensitive is bool
      && request.resource.data.lowerBackSensitive is bool
      && (!request.resource.data.keys().hasAny(['notes'])
        || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500));
    }

    function validChallengeProgress() {
      return request.resource.data.keys().hasOnly([
        'id',
        'challengeId',
        'title',
        'targetDays',
        'completedDays',
        'dailyMinutes',
        'completed',
        'startedAt',
        'updatedAt',
        'completedDateKeys'
      ])
      && request.resource.data.challengeId is string
      && request.resource.data.title is string
      && request.resource.data.targetDays is int
      && request.resource.data.targetDays > 0
      && request.resource.data.targetDays <= 60
      && request.resource.data.completedDays is int
      && request.resource.data.completedDays >= 0
      && request.resource.data.completedDays <= request.resource.data.targetDays
      && request.resource.data.dailyMinutes is int
      && request.resource.data.dailyMinutes >= 0
      && request.resource.data.completed is bool
      && request.resource.data.startedAt is number
      && request.resource.data.updatedAt is number
      && request.resource.data.completedDateKeys is list
      && request.resource.data.completedDateKeys.size() <= 60;
    }

    function validPostCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'content',
          'likes',
          'likedBy',
          'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && request.resource.data.likes == 0
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.createdAt == request.time;
    }

    function validPostUpdate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'content',
          'likes',
          'likedBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() <= 10000
        && request.resource.data.likes == request.resource.data.likedBy.size()
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && (
          validPostLikeUpdate()
          || validPostContentUpdate()
        );
    }

    function validPostLikeUpdate() {
      return request.resource.data.content == resource.data.content
        && updatedAtUnchanged()
        && changedLikeOnlyForCurrentUser();
    }

    function validPostContentUpdate() {
      return request.auth.uid == resource.data.authorId
        && request.resource.data.likes == resource.data.likes
        && request.resource.data.likedBy == resource.data.likedBy
        && request.resource.data.content != resource.data.content
        && request.resource.data.updatedAt == request.time;
    }

    function updatedAtUnchanged() {
      return (!resource.data.keys().hasAny(['updatedAt'])
          && !request.resource.data.keys().hasAny(['updatedAt']))
        || (resource.data.keys().hasAny(['updatedAt'])
          && request.resource.data.keys().hasAny(['updatedAt'])
          && request.resource.data.updatedAt == resource.data.updatedAt);
    }

    function changedLikeOnlyForCurrentUser() {
      let before = resource.data.likedBy.toSet();
      let after = request.resource.data.likedBy.toSet();
      return before.difference(after).union(after.difference(before)).hasOnly([request.auth.uid])
        && before.difference(after).union(after.difference(before)).size() == 1
        && (
          request.auth.uid in resource.data.likedBy
          || resource.data.likedBy.size() < 10000
        );
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser();
      allow delete: if isOwner(uid);

      match /workouts/{workoutId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWorkout();
        allow delete: if isOwner(uid);

        match /exercises/{exerciseId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid) && validExercise();
          allow delete: if isOwner(uid);
        }
      }

      match /progress/{entryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProgress();
        allow delete: if isOwner(uid);
      }

      match /workoutSessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validWorkoutSession()
          && request.resource.data.workoutId == sessionId;
        allow delete: if isOwner(uid);
      }

      match /customWorkouts/{templateId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCustomWorkout();
        allow delete: if isOwner(uid);
      }

      match /nutritionDays/{dateKey} {
        allow read: if isOwner(uid);

        match /foodLogs/{foodLogId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid) && validFoodLog();
          allow delete: if isOwner(uid);
        }
      }

      match /mealPlans/{mealPlanId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validMealPlan();
        allow delete: if isOwner(uid);
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validReminder();
        allow delete: if isOwner(uid);
      }

      match /injuryProfile/{profileId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validInjuryProfile();
        allow delete: if isOwner(uid);
      }

      match /challenges/{challengeId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validChallengeProgress();
        allow delete: if isOwner(uid);
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if validPostCreate();
      allow update: if validPostUpdate();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
