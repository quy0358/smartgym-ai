rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUser() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'photoUrl',
        'beforePhotoUrl',
        'afterPhotoUrl',
        'weight',
        'height',
        'bmi',
        'bmiCategory',
        'goal',
        'createdAt'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.displayName is string
      && request.resource.data.displayName.size() <= 50
      && request.resource.data.email is string;
    }

    function validWorkout() {
      return request.resource.data.keys().hasOnly([
        'id',
        'title',
        'subtitle',
        'intensity',
        'durationMinutes',
        'exercises',
        'exerciseCount',
        'isCompleted',
        'dayOfWeek'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 120
      && request.resource.data.durationMinutes is int
      && request.resource.data.durationMinutes >= 0
      && request.resource.data.dayOfWeek is int
      && request.resource.data.dayOfWeek >= 1
      && request.resource.data.dayOfWeek <= 7
      && (!request.resource.data.keys().hasAny(['exerciseCount'])
        || (request.resource.data.exerciseCount is int
          && request.resource.data.exerciseCount >= 0
          && request.resource.data.exerciseCount <= 50))
      && request.resource.data.isCompleted is bool;
    }

    function validExercise() {
      return request.resource.data.keys().hasOnly([
        'id',
        'name',
        'sets',
        'reps',
        'weight',
        'isCompleted',
        'notes'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() <= 120
      && request.resource.data.sets is int
      && request.resource.data.sets >= 0
      && request.resource.data.reps is int
      && request.resource.data.reps >= 0
      && request.resource.data.isCompleted is bool;
    }

    function validProgress() {
      return request.resource.data.keys().hasOnly([
        'weight',
        'bodyFat',
        'leanMass',
        'date',
        'note',
        'userId'
      ])
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.weight is number
      && request.resource.data.weight >= 20
      && request.resource.data.weight <= 350
      && (!request.resource.data.keys().hasAny(['bodyFat'])
        || (request.resource.data.bodyFat is number
          && request.resource.data.bodyFat >= 0
          && request.resource.data.bodyFat <= 80))
      && (!request.resource.data.keys().hasAny(['leanMass'])
        || (request.resource.data.leanMass is number
          && request.resource.data.leanMass >= 0
          && request.resource.data.leanMass <= 250
          && request.resource.data.leanMass <= request.resource.data.weight))
      && (!request.resource.data.keys().hasAny(['note'])
        || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
      && request.resource.data.date is number
      && request.resource.data.date <= request.time.toMillis() + 5 * 60 * 1000;
    }

    function validCustomWorkout() {
      return request.resource.data.keys().hasOnly([
        'id',
        'title',
        'goal',
        'durationMinutes',
        'exercises',
        'createdAt',
        'injuryAware'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 120
      && request.resource.data.durationMinutes is int
      && request.resource.data.durationMinutes >= 0
      && request.resource.data.durationMinutes <= 240
      && request.resource.data.exercises is list
      && request.resource.data.exercises.size() > 0
      && request.resource.data.exercises.size() <= 50
      && request.resource.data.createdAt is number
      && request.resource.data.injuryAware is bool;
    }

    function validFoodLog() {
      return request.resource.data.keys().hasOnly([
        'id',
        'name',
        'mealType',
        'calories',
        'proteinGrams',
        'carbsGrams',
        'fatGrams',
        'eatenAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.calories is int
      && request.resource.data.calories >= 0
      && request.resource.data.calories <= 5000
      && request.resource.data.proteinGrams is int
      && request.resource.data.carbsGrams is int
      && request.resource.data.fatGrams is int
      && request.resource.data.eatenAt is number;
    }

    function validMealPlan() {
      return request.resource.data.keys().hasOnly([
        'id',
        'title',
        'createdAt',
        'days'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 120
      && request.resource.data.createdAt is number
      && request.resource.data.days is list
      && request.resource.data.days.size() == 7;
    }

    function validReminder() {
      return request.resource.data.keys().hasOnly([
        'id',
        'title',
        'hour',
        'minute',
        'enabled',
        'daysOfWeek'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 80
      && request.resource.data.hour is int
      && request.resource.data.hour >= 0
      && request.resource.data.hour <= 23
      && request.resource.data.minute is int
      && request.resource.data.minute >= 0
      && request.resource.data.minute <= 59
      && request.resource.data.enabled is bool
      && request.resource.data.daysOfWeek is list
      && request.resource.data.daysOfWeek.size() > 0
      && request.resource.data.daysOfWeek.size() <= 7;
    }

    function validInjuryProfile() {
      return request.resource.data.keys().hasOnly([
        'kneeSensitive',
        'shoulderSensitive',
        'lowerBackSensitive',
        'notes'
      ])
      && request.resource.data.kneeSensitive is bool
      && request.resource.data.shoulderSensitive is bool
      && request.resource.data.lowerBackSensitive is bool
      && (!request.resource.data.keys().hasAny(['notes'])
        || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500));
    }

    function validChallengeProgress() {
      return request.resource.data.keys().hasOnly([
        'id',
        'challengeId',
        'title',
        'targetDays',
        'completedDays',
        'dailyMinutes',
        'completed',
        'startedAt',
        'updatedAt',
        'completedDateKeys'
      ])
      && request.resource.data.challengeId is string
      && request.resource.data.title is string
      && request.resource.data.targetDays is int
      && request.resource.data.targetDays > 0
      && request.resource.data.targetDays <= 60
      && request.resource.data.completedDays is int
      && request.resource.data.completedDays >= 0
      && request.resource.data.completedDays <= request.resource.data.targetDays
      && request.resource.data.dailyMinutes is int
      && request.resource.data.dailyMinutes >= 0
      && request.resource.data.completed is bool
      && request.resource.data.startedAt is number
      && request.resource.data.updatedAt is number
      && request.resource.data.completedDateKeys is list
      && request.resource.data.completedDateKeys.size() <= 60;
    }

    function validPostCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'content',
          'likes',
          'likedBy',
          'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && request.resource.data.likes == 0
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.createdAt == request.time;
    }

    function validPostUpdate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'content',
          'likes',
          'likedBy',
          'createdAt'
        ])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.content == resource.data.content
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() <= 10000
        && request.resource.data.likes == request.resource.data.likedBy.size()
        && changedLikeOnlyForCurrentUser();
    }

    function changedLikeOnlyForCurrentUser() {
      let before = resource.data.likedBy.toSet();
      let after = request.resource.data.likedBy.toSet();
      return before.difference(after).union(after.difference(before)).hasOnly([request.auth.uid])
        && before.difference(after).union(after.difference(before)).size() == 1;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser();
      allow delete: if isOwner(uid);

      match /workouts/{workoutId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWorkout();
        allow delete: if isOwner(uid);

        match /exercises/{exerciseId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid) && validExercise();
          allow delete: if isOwner(uid);
        }
      }

      match /progress/{entryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProgress();
        allow delete: if isOwner(uid);
      }

      match /customWorkouts/{templateId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCustomWorkout();
        allow delete: if isOwner(uid);
      }

      match /nutritionDays/{dateKey} {
        allow read: if isOwner(uid);

        match /foodLogs/{foodLogId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid) && validFoodLog();
          allow delete: if isOwner(uid);
        }
      }

      match /mealPlans/{mealPlanId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validMealPlan();
        allow delete: if isOwner(uid);
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validReminder();
        allow delete: if isOwner(uid);
      }

      match /injuryProfile/{profileId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validInjuryProfile();
        allow delete: if isOwner(uid);
      }

      match /challenges/{challengeId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validChallengeProgress();
        allow delete: if isOwner(uid);
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if validPostCreate();
      allow update: if validPostUpdate();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
