<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationContentDescription="@string/action_back"
            app:title="@string/nutrition_title"
            app:titleTextAppearance="@style/TextStyle.BodyBold"
            app:titleTextColor="@color/on_background" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_hero_nutrition"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.SmartGym.RoundedHero" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tab_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/tab_today"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_today"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:text="@string/nutrition_tab_today" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_plan"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:text="@string/nutrition_tab_plan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_history"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:text="@string/nutrition_tab_history" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:id="@+id/today_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        style="@style/Widget.SmartGym.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/nutrition_today_summary"
                                android:textAppearance="@style/TextStyle.BodyBold" />

                            <TextView
                                android:id="@+id/tv_calories_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:textAppearance="@style/TextStyle.HeadlineMd" />

                            <TextView
                                android:id="@+id/tv_calories_over"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:textAppearance="@style/TextStyle.BodyBase"
                                android:textColor="@color/warning"
                                android:visibility="gone" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progress_calories"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:contentDescription="@string/nutrition_today_summary"
                                app:indicatorColor="@color/primary"
                                app:trackColor="@color/surface_container_highest" />

                            <TextView
                                android:id="@+id/tv_macros_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:textAppearance="@style/TextStyle.BodyBase" />

                            <TextView
                                android:id="@+id/tv_protein_progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:textAppearance="@style/TextStyle.BodyBase" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progress_protein"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                app:indicatorColor="@color/nutrition_green"
                                app:trackColor="@color/surface_container_highest" />

                            <TextView
                                android:id="@+id/tv_carbs_progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:textAppearance="@style/TextStyle.BodyBase" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progress_carbs"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                app:indicatorColor="@color/nutrition_yellow"
                                app:trackColor="@color/surface_container_highest" />

                            <TextView
                                android:id="@+id/tv_fat_progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:textAppearance="@style/TextStyle.BodyBase" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progress_fat"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                app:indicatorColor="@color/secondary"
                                app:trackColor="@color/surface_container_highest" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        style="@style/Widget.SmartGym.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/nutrition_add_food"
                                android:textAppearance="@style/TextStyle.BodyBold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_food_name"
                                style="@style/Widget.SmartGym.TextField"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:hint="@string/nutrition_food_name_hint">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_food_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:textColor="@color/on_surface" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_serving"
                                style="@style/Widget.SmartGym.TextField"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:hint="@string/nutrition_serving_hint">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_serving"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:textColor="@color/on_surface" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_meal_type"
                                style="@style/Widget.SmartGym.TextField"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:hint="@string/nutrition_meal_type_hint"
                                app:endIconMode="dropdown_menu">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/et_meal_type"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:completionThreshold="0"
                                    android:inputType="none"
                                    android:text="@string/nutrition_default_meal_type"
                                    android:textColor="@color/on_surface" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_estimate_food"
                                style="@style/Widget.SmartGym.Button.Outline"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_height"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:text="@string/nutrition_estimate_food" />

                            <androidx.cardview.widget.CardView
                                android:id="@+id/estimate_review_card"
                                style="@style/Widget.SmartGym.Card"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="@dimen/spacing_md">

                                    <TextView
                                        android:id="@+id/tv_estimate_review_title"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/nutrition_estimate_review"
                                        android:textAppearance="@style/TextStyle.BodyBold" />

                                    <TextView
                                        android:id="@+id/tv_estimate_review_note"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/spacing_xs"
                                        android:text="@string/nutrition_estimate_note"
                                        android:textAppearance="@style/TextStyle.BodyBase" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:baselineAligned="false"
                                android:orientation="horizontal"
                                android:weightSum="2">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_calories"
                                    style="@style/Widget.SmartGym.TextField"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:hint="@string/nutrition_calories_hint"
                                    app:suffixText="@string/nutrition_unit_kcal">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_calories"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:digits="0123456789."
                                        android:imeOptions="actionNext"
                                        android:inputType="numberDecimal"
                                        android:maxLines="1"
                                        android:textColor="@color/on_surface" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_protein"
                                    style="@style/Widget.SmartGym.TextField"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_weight="1"
                                    android:hint="@string/nutrition_protein_hint"
                                    app:suffixText="@string/nutrition_unit_g">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_protein"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:digits="0123456789."
                                        android:imeOptions="actionNext"
                                        android:inputType="numberDecimal"
                                        android:maxLines="1"
                                        android:textColor="@color/on_surface" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:baselineAligned="false"
                                android:orientation="horizontal"
                                android:weightSum="2">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_carbs"
                                    style="@style/Widget.SmartGym.TextField"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:hint="@string/nutrition_carbs_hint"
                                    app:suffixText="@string/nutrition_unit_g">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_carbs"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:digits="0123456789."
                                        android:imeOptions="actionNext"
                                        android:inputType="numberDecimal"
                                        android:maxLines="1"
                                        android:textColor="@color/on_surface" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_fat"
                                    style="@style/Widget.SmartGym.TextField"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_weight="1"
                                    android:hint="@string/nutrition_fat_hint"
                                    app:suffixText="@string/nutrition_unit_g">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_fat"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:digits="0123456789."
                                        android:imeOptions="actionDone"
                                        android:inputType="numberDecimal"
                                        android:maxLines="1"
                                        android:textColor="@color/on_surface" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_cancel_estimate"
                                    style="@style/Widget.SmartGym.Button.Outline"
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/button_height"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:text="@string/nutrition_cancel_estimate"
                                    android:visibility="gone" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_add_food"
                                    style="@style/Widget.SmartGym.Button.Primary"
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/button_height"
                                    android:layout_marginStart="4dp"
                                    android:layout_weight="1"
                                    android:enabled="false"
                                    android:text="@string/nutrition_btn_add_food" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tv_food_logs_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/nutrition_today_food_logs"
                        android:textAppearance="@style/TextStyle.BodyBold" />

                    <TextView
                        android:id="@+id/tv_food_logs_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/nutrition_empty_food_logs"
                        android:textAppearance="@style/TextStyle.BodyBase" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_food_logs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/plan_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        style="@style/Widget.SmartGym.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/nutrition_ai_plan"
                                android:textAppearance="@style/TextStyle.BodyBold" />

                            <TextView
                                android:id="@+id/tv_meal_plan_preview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/nutrition_empty_plan"
                                android:textAppearance="@style/TextStyle.BodyBase" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_meal_plan_days"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:nestedScrollingEnabled="false"
                                android:visibility="gone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_generate_meal_plan"
                                style="@style/Widget.SmartGym.Button.Primary"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_height"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:text="@string/nutrition_generate_plan" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_log_plan_meal"
                                style="@style/Widget.SmartGym.Button.Outline"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_height"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/nutrition_log_plan_meal"
                                android:visibility="gone" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/history_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        style="@style/Widget.SmartGym.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/nutrition_history_title"
                                android:textAppearance="@style/TextStyle.BodyBold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_history_date"
                                style="@style/Widget.SmartGym.TextField"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:hint="@string/nutrition_history_date_hint">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_history_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionDone"
                                    android:inputType="date"
                                    android:maxLines="1"
                                    android:textColor="@color/on_surface" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_load_history"
                                style="@style/Widget.SmartGym.Button.Outline"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_height"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:text="@string/nutrition_load_history" />

                            <TextView
                                android:id="@+id/tv_history_hint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/nutrition_history_empty_for_date"
                                android:textAppearance="@style/TextStyle.BodyBase" />

                            <TextView
                                android:id="@+id/tv_history_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:textAppearance="@style/TextStyle.BodyBase"
                                android:visibility="gone" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_history_food_logs"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:nestedScrollingEnabled="false"
                                android:visibility="gone" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />
</FrameLayout>
