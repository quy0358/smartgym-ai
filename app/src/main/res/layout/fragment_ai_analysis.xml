<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/ai_title"
            android:textAppearance="@style/TextStyle.HeadlineMd" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginTop="@dimen/spacing_md"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.SmartGym.RoundedHero"
            android:contentDescription="@null"
                    android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/img_hero_progress" />

        <androidx.cardview.widget.CardView
            style="@style/Widget.SmartGym.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_body_report_label"
                    android:textAppearance="@style/TextStyle.LabelCaps"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tv_body_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/TextStyle.BodyBold"
                    tools:text="Bình thường" />

                <TextView
                    android:id="@+id/tv_body_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextStyle.BodyBase"
                    tools:text="BMI: 22.5 • Cân nặng: 70kg • Mục tiêu: 65kg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <include
                        android:id="@+id/stat_body_fat"
                        layout="@layout/item_ai_metric_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/stat_lean_mass"
                        layout="@layout/item_ai_metric_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            style="@style/Widget.SmartGym.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_plan_title"
                    android:textAppearance="@style/TextStyle.BodyBold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/ai_plan_subtitle"
                    android:textAppearance="@style/TextStyle.BodyBase" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_workout"
                    style="@style/Widget.SmartGym.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:minHeight="48dp"
                    android:text="@string/ai_btn_suggest_plan" />

                <ProgressBar
                    android:id="@+id/progress_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:indeterminateTint="@color/primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_plan_response_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/ai_plan_result_label"
                    android:textAppearance="@style/TextStyle.LabelCaps"
                    android:textColor="@color/primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_plan_response"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:lineSpacingMultiplier="1.25"
                    android:textAppearance="@style/TextStyle.BodyBase"
                    android:textIsSelectable="true"
                    android:visibility="gone"
                    tools:text="Gợi ý kế hoạch tập 7 ngày" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            style="@style/Widget.SmartGym.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_form_title"
                    android:textAppearance="@style/TextStyle.BodyBold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/ai_form_subtitle"
                    android:textAppearance="@style/TextStyle.BodyBase" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_exercise_name"
                    style="@style/Widget.SmartGym.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/ai_exercise_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_exercise_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_form_description"
                    style="@style/Widget.SmartGym.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/ai_form_description_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_form_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_analyze_form"
                    style="@style/Widget.SmartGym.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:minHeight="48dp"
                    android:text="@string/ai_btn_analyze_form" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_pose_trainer"
                    style="@style/Widget.SmartGym.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:minHeight="48dp"
                    android:text="@string/pose_open_camera" />

                <ProgressBar
                    android:id="@+id/progress_form"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:indeterminateTint="@color/primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_form_response_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/ai_form_result_label"
                    android:textAppearance="@style/TextStyle.LabelCaps"
                    android:textColor="@color/secondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_form_response"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:lineSpacingMultiplier="1.25"
                    android:textAppearance="@style/TextStyle.BodyBase"
                    android:textIsSelectable="true"
                    android:visibility="gone"
                    tools:text="Kết quả phân tích form" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
