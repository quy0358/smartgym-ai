<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="🤖 Phân tích AI"
            android:textAppearance="@style/TextStyle.HeadlineLg" />

        <!-- Body Metrics Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            style="@style/Widget.SmartGym.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BÁO CÁO CƠ THỂ"
                    android:textAppearance="@style/TextStyle.LabelCaps"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tv_body_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="Mesomorph — Cơ thể dễ tăng cơ"
                    android:textAppearance="@style/TextStyle.BodyBold" />

                <TextView
                    android:id="@+id/tv_body_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="BMI: 22.5 • Cân nặng: 70kg • Mục tiêu: 65kg"
                    android:textAppearance="@style/TextStyle.BodyBase" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- AI Evaluation Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            style="@style/Widget.SmartGym.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ AI ĐÁNH GIÁ"
                    android:textAppearance="@style/TextStyle.LabelCaps"
                    android:textColor="@color/secondary" />

                <TextView
                    android:id="@+id/tv_ai_eval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="Bạn đang trên đường đạt mục tiêu! Tập trung vào bài tập compound để tối ưu kết quả. Tăng cường protein 1.6g/kg/ngày."
                    android:textAppearance="@style/TextStyle.BodyBase"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Metrics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:orientation="horizontal"
            android:weightSum="2">

            <include
                android:id="@+id/stat_body_fat"
                layout="@layout/item_stat_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_xs" />

            <include
                android:id="@+id/stat_lean_mass"
                layout="@layout/item_stat_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs" />
        </LinearLayout>

        <!-- Ask AI button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ask_ai"
            style="@style/Widget.SmartGym.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="🤖 Hỏi AI thêm" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
