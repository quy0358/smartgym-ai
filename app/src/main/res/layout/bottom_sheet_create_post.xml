<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xl">

    <TextView
        android:id="@+id/tv_post_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:text="@string/community_create_post_title"
        android:textAppearance="@style/TextStyle.HeadlineMd" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_post_content"
        style="@style/Widget.SmartGym.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/community_create_post_hint"
        app:counterEnabled="true"
        app:counterMaxLength="500">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_post_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:maxLines="8"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_post"
            style="@style/Widget.SmartGym.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/community_submit_post" />

        <ProgressBar
            android:id="@+id/progress_submit_post"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
